<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Movies{% endblock %}</title>
    <link rel="stylesheet" href="/css/app.css">
  </head>
  <body>
    {# Esta estructura comuna evita repetir navegació i peu en cada vista. #}
    <header>
      <nav aria-label="Navegació principal">
        <a href="/movies">Pel·lícules</a>
        <a href="/movies/new">Afegir pel·lícula</a>
        <a href="/api/movies">API JSON</a>
      </nav>
    </header>
    <main>
      {# Les vistes filles inserixen ací el seu contingut específic. #}
      {% block content %}{% endblock %}
    </main>
    <footer>Aplicació Movies</footer>
  </body>
</html>